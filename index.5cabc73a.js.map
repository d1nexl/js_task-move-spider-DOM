"use strict";
document.addEventListener("click", function(e) {
    var spider = document.querySelector(".spider"); // Отримання павука
    var wall = document.querySelector(".wall"); // Отримання стіни
    var clickX = e.clientX; // Отримання координат кліку
    var clickY = e.clientY;
    var wallRect = wall.getBoundingClientRect(); // Отримання розмірів стіни
    // Перевірка, чи клік в межах стіни
    if (clickX < wallRect.left || clickX > wallRect.right || clickY < wallRect.top || clickY > wallRect.bottom) return;
    // Отримуємо розміри павука
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    // Максимальні та мінімальні межі для павука
    var minCoordX = 0;
    var maxCoordX = wallRect.width - spiderWidth - 20;
    var minCoordY = 0;
    var maxCoordY = wallRect.height - spiderHeight - 20;
    // Обчислюємо нові координати, центруючи павука по кліку
    var newX = Math.min(Math.max(clickX - wallRect.left - spiderWidth / 2, minCoordX), maxCoordX);
    var newY = Math.min(Math.max(clickY - wallRect.top - spiderHeight / 2, minCoordY), maxCoordY);
    // Переміщуємо павука відносно стіни
    spider.style.position = "absolute";
    spider.style.left = "".concat(newX, "px");
    spider.style.top = "".concat(newY, "px");
});

